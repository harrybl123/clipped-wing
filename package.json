{
  "name": "clipped-wing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "npm run ink --silent && tsc --noEmit",
    "ink": "node scripts/ink.mjs",
    "package": "npm run build && rm -f clipped-wing.zip && cd dist && zip -qr ../clipped-wing.zip ."
  },
  "dependencies": {
    "inkjs": "2.4.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
